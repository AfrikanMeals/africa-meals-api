# =============================================================================
# africa-meals-api — production k8s (VPS Wise Eat)
# =============================================================================
#
# Déploiement :
#   sudo infra/k8s/scripts/deploy-api-production.sh africa-meals-api/.env
#
# Sur le VPS (/opt/wise-eat-api) :
#   cp .env .env.prod   # ou symlink
#   sudo /opt/wise-eat/k8s/scripts/deploy-api-production.sh /opt/wise-eat-api/.env
#
# Répartition k8s :
#   • Secret  → create-api-secret.sh (JWT, MONGODB_URI, REDIS_*, STRIPE_*, …)
#   • ConfigMap → infra/k8s/africa-meals-api/configmap.yaml (host.k3s.internal, SNI, pools)
#
# Depuis un pod k3s, host.k3s.internal = boucle vers Stunnel / EMQX / Ollama sur le VPS.
# PM2 prod API : non — pods k3s uniquement (voir infra/k8s/DEPLOY-API.md).
# =============================================================================

APP_NAME="Wise Eat API"

NODE_ENV=production

NODE_PORT=9000
DISABLE_SWAGGER=true

VPS_LOCAL_HOST=host.k3s.internal

SERVER_URL=https://api.wise-eat.com

# CORS (H-01) — allowlist stricte ; clients mobile sans Origin autorisés
CORS_ORIGIN=https://admin.wise-eat.com,https://wise-eat.com,https://www.wise-eat.com,https://dashboard.wise-eat.com,https://web.wise-eat.com

# JWT (H-03) — access court + refresh rotatif
JWT_SECRET=vdUZO8VGOnjRehGHBXkSzchr37SYF2GNdQFYSp72jh5QUhzG
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=wR5D9ET72Zifbx5eb8Le50HWloxCRUt_l_X8PKnW6l3SEDwhGxw1x3Nzig
JWT_REFRESH_EXPIRATION=30d

# Rate limiting auth (H-02)
AUTH_RATE_LIMIT_ENABLED=true

# Durée max d’une requête HTTP (ms) — réception + traitement. Défaut 60000 (1 min).
HTTP_REQUEST_TIMEOUT_MS=60000

## Database — MongoDB rs0 local (pods k8s → host.k3s.internal:27017|27027|27028)
