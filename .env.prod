# Timeout connexion TLS Stunnel (ms) — 20s réduit les ETIMEDOUT au boot multi-processus
REDIS_CONNECT_TIMEOUT_MS=20000
# TCP keepalive (ms) — évite ECONNRESET quand Stunnel ferme les tunnels idle (TIMEOUTidle=120s)
REDIS_TCP_KEEPALIVE_MS=30000


