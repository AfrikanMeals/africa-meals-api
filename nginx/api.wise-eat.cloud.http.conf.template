# HTTP — africa-meals-api (Docker) — SSL terminé par Cloudflare (mode Flexible)
# Origine : port 80 uniquement — pas de certificat Let's Encrypt sur le VPS.
server {
    listen 80;
    listen [::]:80;
    listen ${NGINX_LISTEN_IP}:80;
    server_name ${API_WISE_EAT_DOMAIN};

    client_max_body_size 32m;

    location / {
        proxy_pass http://${API_BACKEND_HOST}:${API_BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_connect_timeout 30s;
    }
}
