APP_NAME="Wise Eat"
NODE_ENV=local
NODE_PORT=9001
# Adaptateurs autorisés : both (Fastify serveur + Express Firebase), fastify ou express.
API_HTTP_ADAPTER=both
# Build + start local (prod PM2) : 9000 — voir docs/PORTS.md
# NODE_PORT=9000
# Durée max d’une requête HTTP (ms) — réception + traitement. Défaut 60000 (1 min).
# HTTP_REQUEST_TIMEOUT_MS=60000
# URL publique de l’API (PayPal return/cancel, liens absolus). Aligner sur le déploiement réel.
SERVER_URL=http://localhost:9001
# Build + start local : http://localhost:9000

# Swagger `/api/docs` — désactivé en prod par défaut (M-02). Dev : opt-out via DISABLE_SWAGGER=true
# DISABLE_SWAGGER=false
# ENABLE_SWAGGER_IN_PROD=false

# GraphQL Playground + introspection — désactivés en prod par défaut (M-02)
# DISABLE_GRAPHQL_PLAYGROUND=false
# ENABLE_GRAPHQL_PLAYGROUND_IN_PROD=false

# Limites corps HTTP (M-03) — JSON 5 MB par défaut ; 25 MB sur routes upload JSON
# HTTP_JSON_BODY_LIMIT=5mb
# HTTP_UPLOAD_JSON_BODY_LIMIT=25mb
# HTTP_URLENCODED_BODY_LIMIT=1mb

# Diagnostic env (GET /api/debug/env) — jamais actif si NODE_ENV=production
# ENABLE_ENV_DEBUG=true
# ENV_DEBUG_BASIC_USER=
# ENV_DEBUG_BASIC_PASS=

# Test e-mail (POST /api/mailer/test-email) — jamais actif si NODE_ENV=production
# ENABLE_MAILER_TEST_EMAIL=true

# Origines CORS autorisées (H-01) — séparées par des virgules, sans slash final.
# Wildcard : `https://*.wise-eat.com` (tous sous-domaines https).
# Toujours autorisé en code : `http(s)://*.wise-eat.com` (vitrine, admin, previews).
# Production (complément optionnel) :
# Allowlist navigateur (virgules). Les sous-domaines *.wise-eat.com sont toujours autorisés (http/https).
# CORS_ORIGIN=https://*.wise-eat.com
# Local (admin :3001, web firebase :5002) :
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5000,http://localhost:5002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5000,http://127.0.0.1:5002

## DNS (mongodb+srv — lookup SRV Atlas)
# Par défaut : résolveurs système (recommandé). Ne pas forcer 1.1.1.1 si SRV Atlas échoue.
# DNS_SERVERS=1.1.1.1,8.8.8.8
# DNS_RESULT_ORDER=ipv4first

## Maintenance base de données (dashboard admin — vider des collections)
# En production : laisser absent ou `false` sauf intervention explicite (`true`).
# ALLOW_DB_MAINTENANCE=true
# ALLOW_DB_BACKUP=true
# DB_BACKUP_DIR=./data/db-backups
# DATABASE_BACKUP_CRON=0 * * * *
# DISABLE_DATABASE_BACKUP_CRON=true

## Stats requêtes (dashboard admin /admin/stats — tampon mémoire)
REQUEST_STATS_ENABLED=false
REQUEST_STATS_MAX_ENTRIES=10000

## Database
# Alternative à DB_HOST / DB_USERNAME / … : URI MongoDB complète
# MONGODB_URI=mongodb+srv://user:pass@cluster.example.net/dbname
# MONGO_URI=…
DB_HOST=main.8zkud1m.mongodb.net
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Pool Mongoose — garder bas sur Atlas (connexions / nœud = somme API + WS + autres × instances).
# MONGOOSE_MAX_POOL=20
# MONGOOSE_MIN_POOL=0
# Fermeture des connexions inactives du pool (ms) — défaut 45s
# MONGOOSE_MAX_IDLE_MS=45000
# MONGOOSE_SERVER_SELECTION_MS=8000
# MONGOOSE_WAIT_QUEUE_MS=30000
# Timeout socket lecture/écriture (ms)
# MONGOOSE_SOCKET_TIMEOUT_MS=45000
# Fréquence heartbeat monitoring (ms) — un peu plus espacé = moins de trafic
# MONGOOSE_HEARTBEAT_FREQ_MS=30000
# Connexions TCP ouvertes en parallèle lors d’un pic de demande (pilote Node)
# MONGOOSE_MAX_CONNECTING=3
# Nom client dans les métriques Atlas (URI construite depuis DB_*)
# MONGODB_APP_NAME=africa-meals-api
# Lectures Mongo : secondaryPreferred (replicas) | primary | secondary | nearest
# Écritures restent sur le primary. Lag ~ms–s après write critique.
# MONGO_READ_PREFERENCE=secondaryPreferred

## Stripe (panier groupé : Checkout Session et/ou PaymentIntent + Payment Sheet mobile)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Plusieurs secrets possibles (ex: Stripe CLI + Dashboard/Event Destination), séparés par virgule.
# STRIPE_WEBHOOK_SECRETS=whsec_cli...,whsec_dashboard...
# Seuil d'alerte (minutes) pour le check "Webhook Stripe last activity" dans Integrity/System Health.
# STRIPE_WEBHOOK_ACTIVITY_MAX_AGE_MIN=30
# Cible p95 (ms) pour l'ack HTTP webhook Stripe (check system-health `stripe-webhook-latency`, EDA-006).
# STRIPE_WEBHOOK_P95_TARGET_MS=500
# Taille fenêtre glissante des échantillons latence webhook (par worker API).
# STRIPE_WEBHOOK_METRICS_MAX_SAMPLES=200
# Limite de scan des integrity tests gourmands (commandes/docs Stripe les plus récents).
# INTEGRITY_TEST_SCAN_LIMIT=5000
# Âge max (heures) toléré pour une commande restant en statut `created`.
# INTEGRITY_CREATED_ORDER_MAX_AGE_HOURS=2
# Config paiements Checkout (Dashboard → Paramètres → Méthodes de paiement) : pmc_…
# STRIPE_PAYMENT_METHOD_CONFIGURATION=pmc_xxxxxxxx
# Webhook Dashboard : même endpoint POST /api/billing/stripe/webhook — activer au minimum
# « checkout.session.completed » (Checkout navigateur) et « payment_intent.succeeded » (Apple Pay / Google Pay / cartes in-app).
# URLs de retour après paiement (optionnel : défaut = page web SSE ou API)
# Avec PUBLIC_WEB_URL : défaut commandes → https://wise-eat.com/checkout-success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5002/checkout-success?session_id={CHECKOUT_SESSION_ID}
# Retour dans l’app mobile (schéma enregistré Android/iOS) :
# STRIPE_CHECKOUT_SUCCESS_URL=wise-eat://stripe-return?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:9000/api/billing/stripe/payment-cancel
# Abonnement vendeur — mobile : PaymentIntent + Payment Sheet (`POST /subscriptions/payment-intent`).
# Checkout hébergé (secours) : page web SSE puis deep link app si PUBLIC_WEB_URL défini.
# STRIPE_SUBSCRIPTION_SUCCESS_URL=https://admin.wise-eat.com/settings/subscription?session_id={CHECKOUT_SESSION_ID}
# STRIPE_SUBSCRIPTION_CANCEL_URL=http://localhost:9000/api/billing/stripe/payment-cancel
# Optionnel: URLs spécifiques au règlement du crédit Ads vendeur.
# Dashboard vendeur (admin Next.js) — utilisé pour les retours Stripe crédit Ads.
# ADMIN_APP_URL=http://localhost:3001
# Sans STRIPE_AD_CREDIT_* : succès → {ADMIN_APP_URL}/ad-credit-return?ad_credit_session_id={CHECKOUT_SESSION_ID}
# STRIPE_AD_CREDIT_SUCCESS_URL=http://localhost:3001/ad-credit-return?ad_credit_session_id={CHECKOUT_SESSION_ID}
# STRIPE_AD_CREDIT_CANCEL_URL=http://localhost:3001/ad-credit-return?ad_credit_payment=cancel
## Stripe Connect (versements vendeurs — admin)
# STRIPE_CONNECT_ADMIN_BASE_URL=http://localhost:3000
# STRIPE_CONNECT_RETURN_URL=http://localhost:3000/finances/versements?connect=return
# STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/finances/versements?connect=refresh
# Site web prérempli sur l’onboarding Stripe vendeur : {PUBLIC_WEB_URL}/stores/{id-nom}
# Livreurs : fallback DASHBOARD_BASE_URL / STRIPE_CONNECT_BUSINESS_WEBSITE_URL
# PUBLIC_WEB_URL=https://wise-eat.com
# DASHBOARD_BASE_URL=https://wise-eat.com
# STRIPE_CONNECT_BUSINESS_WEBSITE_URL=https://wise-eat.com
# Transferts Connect après paiement (plateforme → compte vendeur). false pour désactiver.
# STRIPE_CONNECT_TRANSFERS_ENABLED=true
# STRIPE_CONNECT_TRANSFER_CURRENCY=cad
# Pénalités / compensations Connect (admin). false pour désactiver.
# STRIPE_PENALTIES_ENABLED=true
# Frais Stripe processing (repli si balance_transaction indisponible) : ~2,9 % + 0,30 $ ;
# estimation prudente max(2,9 %, 3,7 %) + 0,30 $ — voir stripe-processing-fee.util.ts

## JWT (H-03)
JWT_SECRET=2vYTSfXEuzF1S4Fy
# Access token court (15–60 min recommandé)
JWT_EXPIRATION=30m
# Secret distinct obligatoire en production (M-08 — pas de fallback sur JWT_SECRET)
JWT_REFRESH_SECRET=change-me-refresh-secret-distinct-from-jwt-secret
JWT_REFRESH_EXPIRATION=30d

# Rate limiting HTTP global (par IP, Redis si disponible sinon mémoire)
HTTP_RATE_LIMIT_ENABLED=true
HTTP_RATE_LIMIT_WINDOW_MS=60000
HTTP_RATE_LIMIT_MAX_PER_IP=120
HTTP_RATE_LIMIT_SSE_MAX_PER_IP=40
HTTP_RATE_LIMIT_KEY_PREFIX=api

# Rate limiting routes auth (H-02)
AUTH_RATE_LIMIT_ENABLED=true

# Rate limiting POST /billing/stripe/grouped-payment-intent (card testing / abus)
STRIPE_GROUPED_PI_RATE_LIMIT_ENABLED=true
# STRIPE_GROUPED_PI_RATE_LIMIT_WINDOW_MS=900000
# STRIPE_GROUPED_PI_RATE_LIMIT_MAX_PER_USER=12
# STRIPE_GROUPED_PI_RATE_LIMIT_MAX_PER_IP=30

## Mail (SMTP / nodemailer) — inscription, vérification, mot de passe oublié
# true = pas d’email, compte marqué vérifié tout de suite (pratique en local)
SKIP_EMAIL_VERIFICATION=false
SUPPORT_EMAIL=support@yourdomain.com
# Mise en page e-mails (logo, couleurs, lien site) — voir docs/MAIL_SETUP.md
# Assets statiques e-mail : africa-meals-web/public/images/ (pas GCS/Firebase)
# EMAIL_WEBSITE_URL=https://wise-eat.com
# (éviter web.wise-eat.com — alias canonisé côté API ; assets = africa-meals-web/public/images)
# Logo header e-mail → {EMAIL_WEBSITE_URL}/logo.png
# Lien « Voir la commande » des e-mails + balisage Gmail (Schema.org Order + Invoice).
# Doit être une URL https publique. `{orderId}` est remplacé par l'id de commande ;
# sans placeholder, l'id est ajouté en suffixe : <base>/orders/<id>.
# PUBLIC_WEB_URL sert aussi aux URLs produit dans acceptedOffer (JSON-LD).
# Lien « Voir la commande » (JSON-LD ViewAction + bouton e-mail). Fallback : PUBLIC_WEB_URL/orders/{orderId}
# EMAIL_ORDER_URL_TEMPLATE=https://wise-eat.com/orders/{orderId}
# E-mails notifications publicitaires (expéditeur marketing, distinct de SMTP_USER)
# Notifications Ads — reprend SMTP_HOST / SMTP_PORT ; seuls user / mot de passe / from diffèrent
# AD_SMTP_USER=sales@votre-domaine.com
# AD_SMTP_APP_PASSWORD=
# AD_SMTP_FROM=sales@votre-domaine.com
# AD_SMTP_FROM_NAME=Wise Eat
# AD_SMTP_HOST=   # optionnel ; défaut = SMTP_HOST
# AD_SMTP_PORT=   # optionnel ; défaut = SMTP_PORT
# PUBLIC_WEB_URL=https://votre-domaine.com
# HTTP Basic Auth — flux Google Merchant Center (export toutes boutiques)
# GOOGLE_MERCHANT_BASIC_AUTH_USER=
# GOOGLE_MERCHANT_BASIC_AUTH_PASSWORD=
# Sitemap site vitrine — déclenche GitHub Actions `regenerate-sitemap` (africa-meals-web)
# PAT fine-grained : repo africa-meals-web, Contents read + Actions write (ou classic repo scope)
# GITHUB_SITEMAP_DISPATCH_TOKEN=ghp_…
# GITHUB_SITEMAP_DISPATCH_REPO=VOTRE_ORG/africa-meals-web
# GITHUB_SITEMAP_DISPATCH_DEBOUNCE_MS=120000
# URL publique de l’API (clics e-mail/SMS notifications ads → /ads/notifications/click/:id)
# API_PUBLIC_BASE_URL=https://api.wise-eat.com
# Worker envoi notifications ads (cron Nest, défaut */3 * * * *)
# AD_NOTIFICATION_DISPATCH_CRON=*/3 * * * *
# DISABLE_AD_NOTIFICATION_DISPATCH_CRON=true
# Secret HMAC pour jetons de tracking clic pub (M-18) — distinct de JWT_SECRET recommandé
# AD_NOTIFICATION_TRACK_SECRET=
# Bird Channels API — SMS et WhatsApp (https://docs.bird.com/api/channels-api)
# Guide déploiement : docs/BIRD_CHANNELS.md
#
# --- Credentials Bird (Secret Manager en prod) ---
# BIRD_ACCESS_KEY=
# BIRD_WORKSPACE_ID=
# BIRD_SMS_CHANNEL_ID=          # UUID canal SMS (dashboard Bird → Channels)
# BIRD_WHATSAPP_CHANNEL_ID=     # UUID canal WhatsApp
# BIRD_EMAIL_CHANNEL_ID=        # UUID canal Email (Bird Channels API)
# BIRD_API_BASE_URL=https://api.bird.com
#
# --- Telegram Bot API (alertes ops admin → Maintenance) ---
# TELEGRAM_BOT_TOKEN=           # @BotFather — requis si MAINTENANCE_TELEGRAM_ENABLED=true
# TELEGRAM_API_BASE_URL=https://api.telegram.org
#
# --- Twilio SMS (moteur alternatif, Paramètres → Maintenance → SMS Engine) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=              # ou TWILIO_PHONE_NUMBER
#
# --- Alertes infra (Paramètres admin → Maintenance) ---
# Canaux ops : nécessitent le toggle admin + flag env ci-dessous
# MAINTENANCE_WHATSAPP_ENABLED=false
# MAINTENANCE_TELEGRAM_ENABLED=false
# MAINTENANCE_SMS_ENABLED=false
# MAINTENANCE_ALERT_DEFAULT_COUNTRY_CODE=1
#
# --- SMS ads ---
# AD_NOTIFICATION_SMS_ENABLED=true
# AD_NOTIFICATION_SMS_DEFAULT_COUNTRY_CODE=1
#
# --- WhatsApp ads ---
# AD_NOTIFICATION_WHATSAPP_ENABLED=true
# AD_NOTIFICATION_WHATSAPP_DEFAULT_COUNTRY_CODE=1
# template = promos hors fenêtre 24 h (défaut) | text = messages libres (fenêtre 24 h)
# AD_NOTIFICATION_WHATSAPP_SEND_MODE=template
# ID projet template Bird Studio (mode template) — remplace l’ancien TEMPLATE_NAME Meta
# AD_NOTIFICATION_WHATSAPP_TEMPLATE_PROJECT_ID=
# AD_NOTIFICATION_WHATSAPP_TEMPLATE_VERSION=latest
# AD_NOTIFICATION_WHATSAPP_TEMPLATE_LANGUAGE=fr
# Clés des paramètres template (ordre : boutique, titre, message) — doivent matcher Bird Studio
# AD_NOTIFICATION_WHATSAPP_TEMPLATE_PARAM_KEYS=store_name,title,message
# Paramètre URL dynamique (suffixe après préfixe fixe du template)
# AD_NOTIFICATION_WHATSAPP_TEMPLATE_URL_BUTTON=true
# AD_NOTIFICATION_WHATSAPP_TEMPLATE_URL_PREFIX=https://api.wise-eat.com/ads/notifications/click/
# AD_NOTIFICATION_WHATSAPP_TEMPLATE_URL_PARAM_KEY=url_suffix
# Ajouter l’URL de clic comme paramètre corps (alternative au bouton URL)
# AD_NOTIFICATION_WHATSAPP_TEMPLATE_BODY_URL_PARAM=false
# MOBILE_DEEP_LINK_SCHEME=wise-eat
# Lien(s) téléchargement app mobile (e-mails onboarding livreur).
# Priorité : Paramètres admin → Apps & Contact (App Store / Play Store en base).
# Repli si non configurés en admin :
# MOBILE_APP_DOWNLOAD_URL=https://wise-eat.com/app
# MOBILE_APP_IOS_URL=https://apps.apple.com/app/...
# MOBILE_APP_ANDROID_URL=https://play.google.com/store/apps/details?id=...
# Canal Android FCM promos (aligné app Flutter : african_meals_promotions)
# AD_NOTIFICATION_FCM_ANDROID_CHANNEL=african_meals_promotions
# File BullMQ ads-notify (nécessite REDIS_URL ou REDIS_HOST)
# AD_NOTIFICATION_QUEUE_NAME=ads-notify
# AD_NOTIFICATION_ENTITY_CONCURRENCY=2
# AD_NOTIFICATION_BATCH_CONCURRENCY=8
# AD_NOTIFICATION_RECIPIENT_BATCH_SIZE=50
# AD_NOTIFICATION_RECIPIENT_PARALLEL=12
# File BullMQ Alert System (Integrity Check → admin, nécessite REDIS_*)
# ADMIN_ALERT_EMAIL_QUEUE_NAME=admin-alert-email
# ADMIN_ALERT_EMAIL_CONCURRENCY=4
# EMAIL_BRAND_PRIMARY=#392800
# EMAIL_BRAND_ACCENT=#aa6900
# Gmail : voir docs/MAIL_SETUP.md — SMTP_APP_PASSWORD ou SMTP_PASS (mot de passe d’application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_PASS=
SMTP_FROM=
# Optionnel (expéditeur si différent de SMTP_USER)
MAILER_SENDER=
# MailerSend (alternative au SMTP) — voir mailer.service
# MAILER_API_KEY=
# Facture PDF par e-mail au client après paiement Stripe (nécessite SMTP pour la pièce jointe)
# Objet : « Your {Restaurant} order #{ref} is now complete » + JSON-LD Order (@graph) + microdata HTML.
# Prérequis Gmail : SPF/DKIM sur le domaine expéditeur, enregistrement du domaine chez Google.
# Tester le balisage : https://developers.google.com/gmail/markup/testing
# DISABLE_ORDER_PAID_INVOICE_EMAIL=true
# E-mail client « commande en livraison » (balisage Schema.org OrderInTransit, sans PDF)
# DISABLE_ORDER_SHIPPED_EMAIL=true
# Trustpilot Automatic Feedback Service — BCC sur le reçu payé (une fois par commande)
# TRUSTPILOT_BCC_EMAIL=wise-eat.com+9bc4407b32@invite.trustpilot.com
# DISABLE_TRUSTPILOT_BCC=true

## Gemini — illustrations IA e-mails onboarding (optionnel)
# Par défaut : illustrations Cursor sur le site :
#   public/images/email-heroes/ (bannière onboarding)
#   public/images/help/ (section « Besoin d'aide ? »)
#   public/images/onboarding-sections/ (sections KYC et Stripe)
# EMAIL_ONBOARDING_HERO_GEMINI=true active la génération live hero (nécessite GEMINI_API_KEY).
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

## Mapbox — séparation tokens (suivi Mapbox : domaine / navigateur / pays sur le pk. public)
MAP_BOX_API_URL=https://api.mapbox.com/search/geocode/v6/forward
# Frontend admin / mobile — pk. servi via GET /platform/map-settings (pas dans le bundle)
# Token public (pk.) — tuiles / Directions admin & mobile via GET /platform/map-settings
# Sans guillemets, une seule ligne (espace/retour ligne = 401 Mapbox)
MAPBOX_PUBLIC_ACCESS_TOKEN=
# Géocodage serveur uniquement — token secret (sk.) avec scope Geocoding Temporary API
MAPBOX_ACCESS_TOKEN=
# Moteur géocodage API : mapbox (défaut) ou osm (Nominatim) — forcer OSM : MAP_GEOCODING_ENGINE=osm
# MAP_GEOCODING_ENGINE=mapbox
# Forcer Pelias (géocode adresses via Elasticsearch) si déployé :
# MAP_GEOCODING_ENGINE=pelias
# PELIAS_BASE_URL=http://localhost:4000
#
# Elasticsearch / OpenSearch — recherche catalogue (restaurants, plats, boissons)
# ELASTICSEARCH_URL=http://127.0.0.1:9200
# OPENSEARCH_URL=   # alias alternatif si pas d’ELASTICSEARCH_URL
# ELASTICSEARCH_CATALOG_INDEX=wise-eat-catalog
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_SEARCH_ENABLED=true   # false pour désactiver même si URL présente
#
# ETA Engine — facteurs optionnels (1 = normal, >1 plus lent)
# ETA_TRAFFIC_FACTOR=1
# ETA_WEATHER_FACTOR=1
# Collecte flotte même si le moteur primaire est « none » (construit la couche) :
# TRAFFIC_FLEET_ALWAYS_COLLECT=true
#
# OpenStreetMap / Nominatim (si MAP_GEOCODING_ENGINE=osm ou fallback sans token Mapbox)
# OSM_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# OSM_NOMINATIM_USER_AGENT=WiseEatApi/1.0
#
# VROOM — optimisation multi-stop / multi-livreurs (auto-offer flotte)
# Matrices : OSRM · Valhalla · Mapbox · Google · HERE · TomTom (pool delivery + cascade)
# Stack : docs/osm-option-d → docker compose --profile vroom up -d
# Aussi : tournée livreur multi-commandes (Pickup A/B → Deliver A/B) via optimizeCourierTour
# VROOM_DISPATCH_ENABLED=true
# VROOM_BASE_URL=http://127.0.0.1:3000
# VROOM_TIMEOUT_MS=8000
# VROOM_MATRIX_ENGINE=osrm   # fallback UNIQUEMENT si Map Settings indisponible
# Priorité matrices / ETA livraison :
#   1) Admin → Paramètres → Carte → pool « mobileDelivery » (multi-engine)
#   2) VROOM_MATRIX_ENGINE (env)
#   3) OSRM
# OSRM_BASE_URL=http://127.0.0.1:8084
# VALHALLA_BASE_URL=http://127.0.0.1:8002
#
# Multi-Level Cache map engine (Redis L1 + Mongo L2) — doc ARCHITECTURE_V2 §10
# MAP_MATRIX_CACHE_TTL_SEC=120
# MAP_ROUTE_CACHE_TTL_SEC=90
# MAP_ETA_CACHE_TTL_SEC=60
# MAP_TRAFFIC_CACHE_TTL_SEC=90
# MAP_DISTANCE_CACHE_TTL_SEC=180
# MAP_HISTORY_ENABLED=true
# MAP_TRAFFIC_SAMPLE_INTERVAL_MS=300000
# MAP_GPS_HISTORY_INTERVAL_MS=300000
#
# Dispatch soft score (auto-offer avant / fallback VROOM)
# Coût = w_dist*km + w_load*(charge×30) + w_route*min_route + w_delay*min_délai
# DISPATCH_WEIGHT_DISTANCE_KM=1
# DISPATCH_WEIGHT_WORKLOAD=1
# DISPATCH_WEIGHT_ROUTE_MIN=0.85
# DISPATCH_WEIGHT_DELAY_MIN=1.15
#
# Maps.co — Nominatim hébergé (quota) ; moteur géocodage « mapsco » dans Admin → Carte
# MAPS_CO_GEOCODING_API_KEY=
# MAPS_CO_GEOCODING_BASE_URL=https://geocode.maps.co
# LocationIQ — Nominatim compatible (quota) ; moteur « locationiq » dans Admin → Carte
# LOCATIONIQ_ACCESS_TOKEN=
# LOCATIONIQ_GEOCODING_BASE_URL=https://us1.locationiq.com/v1
# (Europe : https://eu1.locationiq.com/v1)
# TomTom — Search API Geocoding v2 ; moteur « tomtom » dans Admin → Carte
# TOMTOM_GEOCODING_API_KEY=
# TOMTOM_GEOCODING_BASE_URL=https://api.tomtom.com
# Moteur carte alternatif (sonde page statut + géocodage côté clients).
# GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

## reCAPTCHA Enterprise (formulaire contact web)
# En production, l’application reCAPTCHA est activée par défaut (M-07).
# RECAPTCHA_ENTERPRISE_ENFORCE=false pour désactiver en prod (déconseillé).
# Auth supportée (par ordre) :
# 1) RECAPTCHA_ENTERPRISE_API_KEY (clé API serveur, sans restriction « référents HTTP »), OU
# 2) compte de service dédié wise-eat-com (recommandé) :
#    RECAPTCHA_ENTERPRISE_SERVICE_ACCOUNT_JSON= ou RECAPTCHA_ENTERPRISE_SERVICE_ACCOUNT_PATH=
#    (fichier local : recaptcha-accounts.json — voir recaptcha-accounts.json.example)
# Ne pas réutiliser GOOGLE_APPLICATION_CREDENTIALS (Firebase wise-eat-com / FCM).
# IAM wise-eat-com : roles/recaptchaenterprise.agent sur firebase-adminsdk-fbsvc@wise-eat-com.iam.gserviceaccount.com
# RECAPTCHA_ENTERPRISE_API_KEY=
# Projet GCP où la clé site reCAPTCHA a été créée (site vitrine wise-eat.com).
# RECAPTCHA_ENTERPRISE_PROJECT_ID=wise-eat-com
# RECAPTCHA_ENTERPRISE_SITE_KEY=6LdOmUAtAAAAANsPboCCAIo8EmHUCYLXql23qplw
# RECAPTCHA_ENTERPRISE_SERVICE_ACCOUNT_PATH=recaptcha-accounts.json
# RECAPTCHA_ENTERPRISE_MIN_SCORE=0.5
# RECAPTCHA_ENTERPRISE_ENFORCE=false (Storage / MediasService / push côté serveur)
## ⚠️ Ne pas utiliser le préfixe FIREBASE_ sur les noms de variables : réservé par Cloud Functions (échec de `firebase deploy`).
## Utiliser AM_FIREBASE_* (voir docs/FIREBASE_FUNCTIONS.md).
## ⚠️ Ne jamais committer de clé JSON dans le dépôt — voir accounts.json.example et docs/FIREBASE_KEY_ROTATION.md.
##
## Option A (recommandé prod / CI) — JSON sur une ligne (Secret Manager, GitHub Actions, etc.)
# AM_FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
##
## Option B — champs discrets (Secret Manager multi-clés)
# AM_FIREBASE_SERVICE_ACCOUNT_CLIENT_EMAIL=firebase-adminsdk-...@wise-eat-com.iam.gserviceaccount.com
# AM_FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# AM_FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY_ID=
##
## Option C (local) — fichier hors dépôt (copier accounts.json.example, ne pas le committer)
# AM_FIREBASE_SERVICE_ACCOUNT_PATH=/chemin/absolu/vers/firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/chemin/absolu/vers/firebase-service-account.json
AM_FIREBASE_API_KEY=
AM_FIREBASE_AUTH_DOMAIN=wise-eat-com.firebaseapp.com
AM_FIREBASE_PROJECT_ID=wise-eat-com
AM_FIREBASE_STORAGE_BUCKET=wise-eat-com.firebasestorage.app
AM_FIREBASE_MESSAGING_SENDER_ID=
## App IDs Firebase (Console → Project settings → Your apps) — requis pour minting
## de jetons App Check release depuis Admin → Paramètres → Sécurité.
AM_FIREBASE_APP_ID=
AM_FIREBASE_ANDROID_APP_ID=
AM_FIREBASE_IOS_APP_ID=
AM_FIREBASE_MEASUREMENT_ID=G-1JK3P0CRJ0
## Mint de jetons App Check session (7 j) — android / ios / web.
## Hors prod : public. En prod : Bearer JWT requis (admin/vendeur → API + WS).
## true/false pour forcer le mode public.
# APP_CHECK_SESSION_MINT_ENABLED=true

## Stockage multi-moteur (admin Paramètres → Stockage)
# Moteur par défaut : Firebase (AM_FIREBASE_STORAGE_BUCKET ci-dessus).
# Google Cloud Storage (moteur gcs) — bucket **privé** en production
# Prérequis bucket : Public Access Prevention **enforced** + **pas** d’IAM allUsers
# Clients : Proxy médias ON (Admin → Stockage) → GET /medias/public/…
# Runbook : docs/FIREBASE_STORAGE.md § Production private bucket
# Script : africa-meals-infra/scripts/harden-gcs-bucket.sh
# GCS_BUCKET=
# GOOGLE_CLOUD_STORAGE_BUCKET=
# GCS_PUBLIC_READ=false   # défaut recommandé (pas de makePublic) — true seulement si bucket encore public
# STORAGE_OBJECT_ACL=false
# Amazon S3 (moteur s3) — bucket **privé** en production (pas de CloudFront)
# Prérequis bucket (console AWS → S3 → Permissions) :
#   1. Activer « Block all public access » (les 4 cases)
#   2. Retirer toute policy Principal "*" / s3:GetObject anonyme
#   3. IAM API : s3:GetObject, PutObject, DeleteObject, ListBucket sur le bucket
# Clients : Proxy médias ON (Admin → Stockage, forcé si S3 dans le pool) → GET /medias/public/…
# Runbook : docs/S3_STORAGE.md
# Script : africa-meals-infra/scripts/harden-s3-bucket.sh
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# Sans guillemets (kubectl --from-env-file ne les retire pas — signature S3 invalide sur VPS/k8s)
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_PUBLIC_READ=false   # défaut recommandé — true seulement si bucket encore public (legacy)
# Ne pas définir AWS_S3_PUBLIC_BASE_URL (pas de CDN) — lecture uniquement via proxy API
# STORAGE_OBJECT_ACL=false désactive toutes les ACL objet (GCS/S3/MinIO)
# MinIO (moteur minio) — API S3-compatible (self-hosted ou managed)
# Dev local (Docker infra) :
# MINIO_ENDPOINT=http://127.0.0.1:9000
# MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000/wise-eat
# Prod VPS / k8s (API S3 via nginx TLS ; MinIO Docker = 127.0.0.1:9000 uniquement) :
# MINIO_ENDPOINT=https://storage.wise-eat.com
# MINIO_PUBLIC_BASE_URL=https://storage.wise-eat.com/wise-eat
# Alt CDN objet (pathname = clé, sans bucket) : https://files.wise-eat.com — ne pas re-proxifier
# MINIO_REPLICA_ENDPOINTS=https://dr1-storage.wise-eat.com,https://dr2-storage.wise-eat.com
# k8s : ne pas mettre MINIO_ENDPOINT=http://host.k3s.internal:9000 (ECONNREFUSED depuis les pods)
# MINIO_BUCKET=wise-eat
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_REGION=us-east-1
# MINIO_FORCE_PATH_STYLE=true
# MINIO_PUBLIC_READ=true
# MINIO_HEALTH_CHECK=false
# Failover lecture — CSV des endpoints réplicas (site replication MinIO)
# Prod : https://dr1-storage.wise-eat.com,https://dr2-storage.wise-eat.com
# Dev  : http://127.0.0.1:9002,http://127.0.0.1:9004

# Cloudflare R2 (S3-compatible)
# Dashboard → R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
# R2_ACCOUNT_ID=b301e8487fefc3c5277e2f4b409515dd
# R2_ENDPOINT=https://b301e8487fefc3c5277e2f4b409515dd.r2.cloudflarestorage.com
# R2_BUCKET=wise-eat
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# URL publique (domaine custom ou *.r2.dev si bucket public) — requis sans proxy médias
# R2_PUBLIC_BASE_URL=https://cdn.wise-eat.com

# Web Push VAPID (admin Next.js — NEXT_PUBLIC_FCM_VAPID_KEY) ; l’API Nest n’utilise pas cette clé pour envoyer les FCM
# FCM_WEB_VAPID_KEY=

# Seed démo au démarrage (désactivé par défaut). Mettre true uniquement si vous voulez
# regénérer commandes / avis plats de démo à chaque lancement de l’API.
# Seeds démo (jamais en production — L-04)
# ENABLE_CATALOG_SEED=true
# DEMO_SEED_PASSWORD=SeedPassword123!
# SEED_DEMO_ORDERS=true
# SEED_DEMO_PRODUCT_RATINGS=true
# SEED_DEMO_DELIVERY_DRIVERS=true

# Stripe (secret plateforme — Connect + balance transactions)
# STRIPE_SECRET_KEY=sk_live_... ou sk_test_...
# URL publique du Dashboard (sans slash final) — obligatoire pour les URLs de retour onboarding Connect
# DASHBOARD_BASE_URL=http://localhost:3000
# Pays ISO2 par défaut si l’adresse boutique / le profil vendeur n’a pas de pays (Express Connect)
# STRIPE_CONNECT_DEFAULT_COUNTRY=CA

# PAYPAL
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# --- Inter-services : africa-meals-ws ↔ API ---
# URL du service WS (sans slash final). Utilisée pour notifier le salon Socket `user:{id}` (fil boutique / inbox).
# Ex. local dev : http://localhost:8001  |  build + start : http://localhost:8000  |  prod : https://ws.votredomaine.com
AFRICA_MEALS_WS_INTERNAL_URL=http://localhost:8001
# Même secret que `INTERNAL_NOTIFY_SECRET` sur africa-meals-ws (header X-Internal-Secret).
INTERNAL_NOTIFY_SECRET=
# Alias optionnel (WsInboxNotifyService)
# INTERNAL_WS_NOTIFY_SECRET=

# --- gRPC interne API → WS (désactivé par défaut — voir docs/GRPC_INTEGRATION.md) ---
# GRPC_VERSION=1
# GRPC_DOMAIN_BUS_ENABLED=false
# GRPC_DOMAIN_BUS_MQTT_FALLBACK_ENABLED=true
# GRPC_CART_PREVIEW_GRPC_ENABLED=false
# WS_NOTIFY_WORKER_EXTERNAL=false
# GRPC_PHASE4_BRIDGE_ENABLED=false
# GRPC_WS_NOTIFY_ENABLED=false
# GRPC_WS_HOST=127.0.0.1
# GRPC_WS_PORT=50051
# GRPC_HTTP_FALLBACK_ENABLED=true
# GRPC_DEADLINE_MS=5000
# GRPC_MAX_RECV_MB=4
# GRPC_CIRCUIT_FAILURE_THRESHOLD=5
# GRPC_CIRCUIT_COOLDOWN_MS=30000
# GRPC_API_SERVER_ENABLED=true
# GRPC_API_PORT=50052

# Liens vendeur / dashboard (emails, invitations — store.service, Stripe Connect)
# DASHBOARD_BASE_URL=https://wise-eat.com
# VENDOR_SIGNUP_URL=
# FRONTEND_URL=
# CLIENT_APP_URL=

# --- Cache perf (Nest cache-manager global) ---
# Liste publique `GET /api/product-categories` + query GraphQL `productCategories` (ms)
# PRODUCT_CATEGORIES_CACHE_TTL_MS=120000
# Bundle accueil GraphQL `shopHome` (ms)
# SHOP_HOME_CACHE_TTL_MS=90000
# TTL cache public catalogue / recherche / menu boutique / détail plat (ms)
# API_PUBLIC_CACHE_TTL_MS=90000
# Favoris GraphQL (ms)
# FAVORITES_CACHE_TTL_MS=25000
# Feed recommandations GET /recommendations (ms) — Admin → Cache aussi
# RECOMMENDATIONS_CACHE_TTL_MS=45000
# Logs HTTP : requêtes terminées (méthode, URL, status coloré, durée). Activé en dev par défaut.
# LOG_HTTP_REQUESTS=true
# Couleurs ANSI dans les logs (auto si TTY ; PM2 : FORCE_COLOR=1)
# LOG_HTTP_USE_COLORS=true
# Logs HTTP : corps des requêtes (déconseillé en prod — coût CPU / fuite données)
# LOG_HTTP_BODIES=false
# Forcer en production uniquement si absolument nécessaire (L-05)
# LOG_HTTP_BODIES_IN_PROD=false

# --- Ads targeting ---
# Conservation des événements comportementaux (jours)
# ADS_TARGETING_DATA_RETENTION_DAYS=90

# --- Redis cache + pub/sub SSE (API + WS) ---
# Prod Stunnel (Let's Encrypt sur cache.wise-eat.com) — primary :
# REDIS_URL=rediss://wise-eat-cache:<password>@cache.wise-eat.com:6381
# REDIS_HOST=cache.wise-eat.com
# REDIS_PORT=6381
# REDIS_USERNAME=wise-eat-cache
# REDIS_PASSWORD=
# REDIS_TLS=true
# Cert LE (défaut) : true ou omettre — cert auto-signé temporaire : false
# REDIS_TLS_REJECT_UNAUTHORIZED=true
# Réplicas VPS (127.0.0.1 — failover auto primary → replica-1 → replica-2) :
# REDIS_REPLICA_1_URL=redis://wise-eat-cache:<password>@127.0.0.1:6371
# REDIS_REPLICA_2_URL=redis://wise-eat-cache:<password>@127.0.0.1:6372
# REDIS_REPLICA_1_PORT=6371
# REDIS_REPLICA_2_PORT=6372
#
# Local Docker infra (./install.sh redis, profile cluster-b) :
# REDIS_URL=redis://wise-eat-cache:<password>@127.0.0.1:6379
# REDIS_TLS=false
# Timeout connexion TLS Stunnel (ms, défaut 15000)
# REDIS_CONNECT_TIMEOUT_MS=15000
# Si l’IPv4 vers le VPS est bloquée (FAI) : forcer AAAA — 4 | 6 | omis (auto DNS)
# REDIS_IP_FAMILY=6
#
# --- Memcached cache (API — couche L2) ---
# Prod Stunnel TLS (primary cache.wise-eat.com:11212) :
# MEMCACHED_SERVERS=cache.wise-eat.com:11212
# MEMCACHED_TLS=true
# Cert LE (défaut) : true ou omettre — cert auto-signé temporaire : false
# MEMCACHED_TLS_REJECT_UNAUTHORIZED=true
# SNI si hostname ≠ cert (défaut : host du premier serveur)
# MEMCACHED_TLS_SERVERNAME=cache.wise-eat.com
# MEMCACHED_CONNECT_TIMEOUT_MS=15000
# Pools standby (failover manuel : basculer MEMCACHED_SERVERS) :
# MEMCACHED_REPLICA_1_SERVERS=127.0.0.1:11213
# MEMCACHED_REPLICA_2_SERVERS=127.0.0.1:11214
#
# Local / VPS (127.0.0.1, sans TLS) :
# MEMCACHED_SERVERS=127.0.0.1:11211
# MEMCACHED_TLS=false
#
# --- Neo4j / GraphDB (reco graphe — défaut OFF, fail-open Mongo) ---
# Seed initial Mongo `graphdb_settings` ; runtime = Admin → Paramètres → GraphDB
# (sans redeploy). Secrets URI restent ici / Secret Manager (jamais en Mongo).
# Doc : africa-meals-project/docs/NEO4J_INTEGRATION.md §10
#
# Off (local / CI / avant go-live) :
# NEO4J_ENABLED=false
# RECO_GRAPH_ENABLED=false
# GRAPH_SYNC_ENABLED=false
#
# Staging sync-only (peupler le graphe, clients en reco Mongo) :
# NEO4J_ENABLED=true
# NEO4J_URI=bolt://host.k3s.internal:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j
# GRAPH_SYNC_ENABLED=true
# RECO_GRAPH_ENABLED=false
# RECO_GRAPH_TIMEOUT_MS=200
# GRAPH_SYNC_QUEUE=graph-sync
# Concurrency workers graph-sync (default 2). Jobs map : courier.presence + traffic.sample
# (throttle) — routing reste OSRM, pas Cypher shortestPath.
#
# Prod graphe :
# NEO4J_ENABLED=true
# GRAPH_SYNC_ENABLED=true
# RECO_GRAPH_ENABLED=true
# RECO_GRAPH_TIMEOUT_MS=120
# GRAPH_PROMO_AUDIENCE_ENABLED=false
# GRAPH_FRAUD_ENABLED=false
#
# Incident : préférer Admin → GraphDB → NEO4J_ENABLED OFF (immédiat)
#
# --- Redis BullMQ (files jobs — API + WS dispatch interne) ---
# Prod Stunnel BullMQ (primary) :
# BULLMQ_REDIS_URL=rediss://wise-eat-bull:<password>@cache.wise-eat.com:6382
# BULLMQ_REDIS_TLS=true
# BULLMQ_REDIS_TLS_REJECT_UNAUTHORIZED=true
# BULLMQ_REDIS_REPLICA_1_URL=redis://wise-eat-bull:<password>@127.0.0.1:6390
# BULLMQ_REDIS_REPLICA_2_URL=redis://wise-eat-bull:<password>@127.0.0.1:6391
# BULLMQ_REDIS_REPLICA_1_PORT=6390
# BULLMQ_REDIS_REPLICA_2_PORT=6391
#
# WS VPS local :
# BULLMQ_REDIS_URL=redis://wise-eat-bull:<password>@127.0.0.1:6380
# BULLMQ_REDIS_TLS=false
#
# Si absent : repli automatique sur REDIS_* (instance partagée).
# BULLMQ_REDIS_HOST=
# BULLMQ_REDIS_PORT=6380
# BULLMQ_REDIS_USERNAME=
# BULLMQ_REDIS_PASSWORD=
# BULLMQ_PREFIX={bull}   # requis en mode Redis Cluster
#
# --- BullMQ (API -> WS internal notify queue) ---
# WS_NOTIFY_QUEUE_NAME=ws-notify
# WS_NOTIFY_QUEUE_CONCURRENCY=20
# WS_NOTIFY_QUEUE_ATTEMPTS=4
# WS_NOTIFY_QUEUE_BACKOFF_MS=750
# WS_NOTIFY_QUEUE_KEEP_COMPLETED=1000
# WS_NOTIFY_QUEUE_KEEP_FAILED=5000
# WS_NOTIFY_REQUEST_TIMEOUT_MS=8000
#
# --- Domain events (EDA bus — distinct de internal/ws) ---
# DOMAIN_EVENTS_ENABLED=false
# DOMAIN_EVENTS_QUEUE_NAME=domain-events
# DOMAIN_EVENTS_QUEUE_CONCURRENCY=10
# DOMAIN_EVENTS_QUEUE_ATTEMPTS=4
# DOMAIN_EVENTS_QUEUE_BACKOFF_MS=750
# DOMAIN_EVENTS_QUEUE_KEEP_COMPLETED=2000
# DOMAIN_EVENTS_QUEUE_KEEP_FAILED=5000
# DOMAIN_EVENTS_IDEMPOTENCY_TTL_SEC=86400
# DOMAIN_EVENTS_HANDLERS_ASYNC=true
# DOMAIN_EVENTS_HANDLERS_QUEUE_NAME=domain-events-handlers
# DOMAIN_EVENTS_HANDLERS_QUEUE_CONCURRENCY=5
# DOMAIN_EVENTS_HANDLERS_QUEUE_ATTEMPTS=4
# DOMAIN_EVENTS_HANDLERS_QUEUE_BACKOFF_MS=750
# DOMAIN_EVENTS_HANDLERS_QUEUE_KEEP_COMPLETED=2000
# DOMAIN_EVENTS_HANDLERS_QUEUE_KEEP_FAILED=5000
# DOMAIN_EVENTS_WS_VIA_BUS=true
# DOMAIN_EVENTS_MQTT_TOPIC_PREFIX=africameals/domain
#
# --- GPS livreur (OPT-002) ---
# COURIER_GPS_THROTTLE_MS=3000
# Flotte WS/SSE : AGENT_LOCATION_EMIT_THROTTLE_MS = 3000 (code) — aligné tip 2–3 s
# COURIER_GPS_COORD_PRECISION=4
#
# --- SSE (Server-Sent Events) ---
# POLL-000 : l’API publie sur Redis ; le flux HTTP SSE est servi par africa-meals-ws (Cloud Run).
SSE_HOST_ON_WS=true
SSE_REDIS_BRIDGE_ENABLED=true
SSE_HTTP_ON_API=false
# SSE_HEARTBEAT_MS=20000
# SSE_MAX_CONNECTIONS_PER_USER=5
# REQUEST_STATS_SSE_PUSH_MS=10000
# STATUS_PROBE_WEB_URL=https://wise-eat.com/
# STATUS_PROBE_ADMIN_URL=https://admin.wise-eat.com/
# WS_BASE_URL=https://ws.wise-eat.com
# STATUS_PROBE_TIMEOUT_MS=8000
#
# --- MQTT Broker (HiveMQ Cloud / autre broker) ---
# MQTT VPS (EMQX) — dev + prod via domaine (pas d’IP directe)
# API publisher : wise-eat-admin + MQTT_ADMIN_PASSWORD depuis infra/emqx/.env.emqx
# MQTT_BROKER_HOST=broker.wise-eat.com
# MQTT_BROKER_PORT=8883
# MQTT_BROKER_WS_PORT=8884
# MQTT_BROKER_PROTOCOL=mqtts
# MQTT_BROKER_URL=mqtts://broker.wise-eat.com:8883
# MQTT_BROKER_WS_URL=wss://broker.wise-eat.com:8884/mqtt
# MQTT_BROKER_USERNAME=wise-eat-admin
# MQTT_BROKER_PASSWORD=
# MQTT_TOPIC_PREFIX=africameals/internal/ws
# MQTT_QOS=1
# MQTT_CONNECT_TIMEOUT_MS=8000
# MQTT_KEEPALIVE_SEC=30
# MQTT_RECONNECT_MS=2000
#
# --- Crons : pause/reprise admin → Integrity Check → Cron Jobs (collection infra_cron_job_states) ---
# Désactivation déploiement : DISABLE_<JOB>_CRON=true (voir cron-jobs.registry.ts)
# DISABLE_ADS_TARGETING_RETENTION_CRON=true
#
# --- Rapport d'activité vendeur (e-mail + Excel, un envoi par propriétaire) ---
# Destinataires : e-mail du compte propriétaire de chaque boutique ACTIVE/INACTIVE.
# Fréquence (quotidien / hebdo / mensuel) : admin Paramètres → Rapport vendeur
# ADMIN_OPS_REPORT_CRON=15 * * * *
# DISABLE_ADMIN_OPS_REPORT_CRON=true
#
# --- Promotions planifiées (plats vendeur : prix / promo par plage de dates) ---
# PRODUCT_DISCOUNT_SCHEDULE_CRON=0/5 * * * *
# DISABLE_PRODUCT_DISCOUNT_SCHEDULE_CRON=true
# PENDING_DELIVERY_AUTO_CLOSE_CRON=0 6 * * *
# DISABLE_PENDING_DELIVERY_AUTO_CLOSE_CRON=true
# PENDING_DELIVERY_AUTO_CLOSE_DAYS=7
#
# --- Push recommandations (classifier → planner → FCM) ---
# Kill switch déploiement (prioritaire sur pushRecoEnabled admin) :
# DISABLE_PUSH_RECO=true
# PUSH_RECO_CLASSIFIER_CRON=0 4 * * *
# PUSH_RECO_PLANNER_CRON=*/20 * * * *
# PUSH_RECO_LLM_BASE_URL=http://127.0.0.1:11434
# PUSH_RECO_LLM_MODEL=llama3.2:3b
# PUSH_RECO_LLM_TIMEOUT_MS=8000
# Réglages fins (caps, quiet hours, rollout) : Admin → Paramètres → Automatisation
#
# --- Agrégation performances engagement (push reco, newsletter…) ---
# ENGAGEMENT_PERFORMANCE_AGGREGATION_CRON=0 2 * * *
# DISABLE_ENGAGEMENT_PERFORMANCE_AGGREGATION_CRON=true
# ENGAGEMENT_PERFORMANCE_EVENTS_TTL_DAYS=90
#
# --- Newsletter food (digest boutiques abonnées + reco email) ---
# FOOD_NEWSLETTER_ENABLED=true
# DISABLE_FOOD_NEWSLETTER=true
# FOOD_NEWSLETTER_CLASSIFIER_CRON=0 5 * * *
# FOOD_NEWSLETTER_PLANNER_CRON=0 9 * * 2,4
# FOOD_NEWSLETTER_LLM_BASE_URL=http://127.0.0.1:11434
# FOOD_NEWSLETTER_LLM_MODEL=llama3.2:3b
# FOOD_NEWSLETTER_TRACK_SECRET=
# Réglages fins (caps, rollout, sections) : Admin → Paramètres → Automatisation → Newsletter
