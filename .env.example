APP_NAME="African Meals"
NODE_ENV=local
NODE_PORT=9000
# Durée max d’une requête HTTP (ms) — réception + traitement. Défaut 60000 (1 min).
# HTTP_REQUEST_TIMEOUT_MS=60000
# URL publique de l’API (PayPal return/cancel, liens absolus). Aligner sur le déploiement réel.
SERVER_URL=http://localhost:9000

# Swagger : mettre `true` pour désactiver /api/docs en prod
# DISABLE_SWAGGER=false

# Origines autorisées pour le Dashboard (séparées par des virgules). Si vide, toutes les origines en dev.
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

## Database
# Alternative à DB_HOST / DB_USERNAME / … : URI MongoDB complète
# MONGODB_URI=mongodb+srv://user:pass@cluster.example.net/dbname
# MONGO_URI=…
DB_HOST=main.8zkud1m.mongodb.net
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Pool Mongoose — garder bas sur Atlas (connexions / nœud = somme API + WS + autres × instances).
# MONGOOSE_MAX_POOL=20
# MONGOOSE_MIN_POOL=0
# Fermeture des connexions inactives du pool (ms) — défaut 45s
# MONGOOSE_MAX_IDLE_MS=45000
# MONGOOSE_SERVER_SELECTION_MS=8000
# MONGOOSE_WAIT_QUEUE_MS=30000
# Timeout socket lecture/écriture (ms)
# MONGOOSE_SOCKET_TIMEOUT_MS=45000
# Fréquence heartbeat monitoring (ms) — un peu plus espacé = moins de trafic
# MONGOOSE_HEARTBEAT_FREQ_MS=30000
# Connexions TCP ouvertes en parallèle lors d’un pic de demande (pilote Node)
# MONGOOSE_MAX_CONNECTING=3
# Nom client dans les métriques Atlas (URI construite depuis DB_*)
# MONGODB_APP_NAME=africa-meals-api

## Stripe (panier groupé : Checkout Session et/ou PaymentIntent + Payment Sheet mobile)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook Dashboard : même endpoint POST /api/billing/stripe/webhook — activer au minimum
# « checkout.session.completed » (Checkout navigateur) et « payment_intent.succeeded » (Apple Pay / Google Pay / cartes in-app).
# URLs de retour après paiement (optionnel : défaut = pages HTML sur cette API)
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:9000/api/billing/stripe/payment-done?session_id={CHECKOUT_SESSION_ID}
# Retour dans l’app mobile (schéma enregistré Android/iOS) :
# STRIPE_CHECKOUT_SUCCESS_URL=africameals://stripe-return?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:9000/api/billing/stripe/payment-cancel
## Stripe Connect (versements vendeurs — admin)
# STRIPE_CONNECT_ADMIN_BASE_URL=http://localhost:3000
# STRIPE_CONNECT_RETURN_URL=http://localhost:3000/finances/versements?connect=return
# STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/finances/versements?connect=refresh
# Site web prérempli sur l’onboarding Stripe (« Business website ») — business_profile.url
# DASHBOARD_BASE_URL=https://afrikan-meals.com
# STRIPE_CONNECT_BUSINESS_WEBSITE_URL=https://afrikan-meals.com
# Transferts Connect après paiement (plateforme → compte vendeur). false pour désactiver.
# STRIPE_CONNECT_TRANSFERS_ENABLED=true
# STRIPE_CONNECT_TRANSFER_CURRENCY=cad

## JWT
JWT_SECRET=2vYTSfXEuzF1S4Fy
JWT_EXPIRATION=1y

## Mail (SMTP / nodemailer) — inscription, vérification, mot de passe oublié
# true = pas d’email, compte marqué vérifié tout de suite (pratique en local)
SKIP_EMAIL_VERIFICATION=false
SUPPORT_EMAIL=support@yourdomain.com
# Gmail : voir docs/MAIL_SETUP.md — SMTP_APP_PASSWORD ou SMTP_PASS (mot de passe d’application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_PASS=
SMTP_FROM=
# Optionnel (expéditeur si différent de SMTP_USER)
MAILER_SENDER=
# MailerSend (alternative au SMTP) — voir mailer.service
# MAILER_API_KEY=

## Mapbox (géocodage adresses)
MAP_BOX_API_URL=https://api.mapbox.com/search/geocode/v6/forward
MAPBOX_ACCESS_TOKEN=

## Firebase Admin (Storage / MediasService / push côté serveur)
## ⚠️ Ne pas utiliser le préfixe FIREBASE_ sur les noms de variables : réservé par Cloud Functions (échec de `firebase deploy`).
## Utiliser AM_FIREBASE_* (voir docs/FIREBASE_FUNCTIONS.md).
## Option A: chemin vers le JSON du compte de service (relatif à la racine du projet).
# GOOGLE_APPLICATION_CREDENTIALS=accounts.json
## Option B: JSON du compte de service sur une seule ligne (CI / secrets).
# AM_FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# AM_FIREBASE_SERVICE_ACCOUNT_PATH=accounts.json
AM_FIREBASE_PROJECT_ID=
AM_FIREBASE_STORAGE_BUCKET=

# Web Push VAPID (admin Next.js — NEXT_PUBLIC_FCM_VAPID_KEY) ; l’API Nest n’utilise pas cette clé pour envoyer les FCM
# FCM_WEB_VAPID_KEY=

## Config client Firebase (Flutter / web) — ne pas préfixer par FIREBASE_ dans ce fichier si vous déployez des Functions.
## Renommez par ex. : AM_WEB_API_KEY, AM_WEB_AUTH_DOMAIN, AM_WEB_PROJECT_ID, etc., ou gardez-les uniquement dans le projet mobile.

# Données démo au démarrage (désactivé par défaut). Mettre true pour activer.
# SEED_DEMO_ORDERS=true
# SEED_DEMO_PRODUCT_RATINGS=true

# PAYPAL
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# --- Inter-services : africa-meals-ws ↔ API ---
# URL du service WS (sans slash final). Utilisée pour notifier le salon Socket `user:{id}` (fil boutique / inbox).
# Ex. local : http://localhost:8000  |  prod : https://ws.votredomaine.com
AFRICA_MEALS_WS_INTERNAL_URL=http://localhost:8000
# Même secret que `INTERNAL_NOTIFY_SECRET` sur africa-meals-ws (header X-Internal-Secret).
INTERNAL_NOTIFY_SECRET=
# Alias optionnel (WsInboxNotifyService)
# INTERNAL_WS_NOTIFY_SECRET=

# Liens vendeur / dashboard (emails, invitations — store.service, Stripe Connect)
# DASHBOARD_BASE_URL=https://afrikan-meals.com
# VENDOR_SIGNUP_URL=
# FRONTEND_URL=
# CLIENT_APP_URL=

# --- Cache perf (Nest cache-manager global) ---
# Liste publique `GET /api/product-categories` + query GraphQL `productCategories` (ms)
# PRODUCT_CATEGORIES_CACHE_TTL_MS=120000
# Bundle accueil GraphQL `shopHome` (ms)
# SHOP_HOME_CACHE_TTL_MS=90000
# Favoris GraphQL (ms)
# FAVORITES_CACHE_TTL_MS=25000
# Logs HTTP : corps des requêtes (déconseillé en prod — coût CPU / fuite données)
# LOG_HTTP_BODIES=false
