MAPBOX_ACCESS_TOKEN=

## reCAPTCHA Enterprise (formulaire contact web)
# En production, l’application reCAPTCHA est activée par défaut (M-07).
# RECAPTCHA_ENTERPRISE_ENFORCE=false pour désactiver en prod (déconseillé).
# Auth supportée:
# 1) API key via RECAPTCHA_ENTERPRISE_API_KEY, OU
# 2) service account via GOOGLE_APPLICATION_CREDENTIALS / ADC (sans clé API).
# RECAPTCHA_ENTERPRISE_API_KEY=
# RECAPTCHA_ENTERPRISE_PROJECT_ID=wise-eat-ca # fallback auto: AM_FIREBASE_PROJECT_ID
# RECAPTCHA_ENTERPRISE_SITE_KEY=6LfNGP4sAAAAAGVqnfLU6i0rKX2rbol1RlyLm3p2
# RECAPTCHA_ENTERPRISE_MIN_SCORE=0.5
# RECAPTCHA_ENTERPRISE_ENFORCE=false (Storage / MediasService / push côté serveur)
## ⚠️ Ne pas utiliser le préfixe FIREBASE_ sur les noms de variables : réservé par Cloud Functions (échec de `firebase deploy`).
## Utiliser AM_FIREBASE_* (voir docs/FIREBASE_FUNCTIONS.md).
## ⚠️ Ne jamais committer de clé JSON dans le dépôt — voir accounts.json.example et docs/FIREBASE_KEY_ROTATION.md.
##
## Option A (recommandé prod / CI) — JSON sur une ligne (Secret Manager, GitHub Actions, etc.)
# AM_FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
##
## Option B — champs discrets (Secret Manager multi-clés)
# AM_FIREBASE_SERVICE_ACCOUNT_CLIENT_EMAIL=firebase-adminsdk-...@wise-eat-ca.iam.gserviceaccount.com
# AM_FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# AM_FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY_ID=
##
## Option C (local) — fichier hors dépôt (copier accounts.json.example, ne pas le committer)
# AM_FIREBASE_SERVICE_ACCOUNT_PATH=/chemin/absolu/vers/firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/chemin/absolu/vers/firebase-service-account.json
AM_FIREBASE_API_KEY=
AM_FIREBASE_AUTH_DOMAIN=wise-eat-ca.firebaseapp.com
AM_FIREBASE_PROJECT_ID=wise-eat-ca
AM_FIREBASE_STORAGE_BUCKET=wise-eat-ca.firebasestorage.app
AM_FIREBASE_MESSAGING_SENDER_ID=
AM_FIREBASE_APP_ID=
AM_FIREBASE_MEASUREMENT_ID=G-1JK3P0CRJ0

## Stockage multi-moteur (admin Paramètres → Stockage)
# Moteur par défaut : Firebase (AM_FIREBASE_STORAGE_BUCKET ci-dessus).
# Google Cloud Storage (moteur gcs) — URLs publiques https://storage.googleapis.com/{bucket}/…
# Prérequis bucket : désactiver public access prevention + IAM allUsers:objectViewer
# GCS_BUCKET=
# GOOGLE_CLOUD_STORAGE_BUCKET=
# GCS_PUBLIC_READ=true
# Amazon S3 (moteur s3) — URLs publiques https://{bucket}.s3.amazonaws.com/…
# Prérequis bucket (console AWS → S3 → wise-eat → Permissions) :
#   1. Désactiver « Block all public access » (autoriser accès public via politique)
#   2. Politique bucket (lecture seule) :
    #  { "Effect": "Allow", "Principal": "*", "Action": "s3:GetObject",
    #    "Resource": "arn:aws:s3:::wise-eat/*" }
#   3. AWS_S3_PUBLIC_READ=true (défaut) — tente ACL public-read à l’upload
# Proxy médias (admin → Paramètres → Stockage) : si activé, URLs via GET /medias/public/…
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_PUBLIC_READ=true
# AWS_S3_PUBLIC_BASE_URL=https://cdn.wise-eat.com

# Web Push VAPID (admin Next.js — NEXT_PUBLIC_FCM_VAPID_KEY) ; l’API Nest n’utilise pas cette clé pour envoyer les FCM
# FCM_WEB_VAPID_KEY=

# Seed démo au démarrage (désactivé par défaut). Mettre true uniquement si vous voulez
# regénérer commandes / avis plats de démo à chaque lancement de l’API.
# Seeds démo (jamais en production — L-04)
# ENABLE_CATALOG_SEED=true
# DEMO_SEED_PASSWORD=SeedPassword123!
# SEED_DEMO_ORDERS=true
# SEED_DEMO_PRODUCT_RATINGS=true
# SEED_DEMO_DELIVERY_DRIVERS=true

# Stripe (secret plateforme — Connect + balance transactions)
# STRIPE_SECRET_KEY=sk_live_... ou sk_test_...
# URL publique du Dashboard (sans slash final) — obligatoire pour les URLs de retour onboarding Connect
# DASHBOARD_BASE_URL=http://localhost:3000
# Pays ISO2 par défaut si l’adresse boutique / le profil vendeur n’a pas de pays (Express Connect)
# STRIPE_CONNECT_DEFAULT_COUNTRY=CA

# PAYPAL
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# --- Inter-services : africa-meals-ws ↔ API ---
# URL du service WS (sans slash final). Utilisée pour notifier le salon Socket `user:{id}` (fil boutique / inbox).
# Ex. local dev : http://localhost:8000  |  build + start : http://localhost:8001  |  prod : https://ws.votredomaine.com
AFRICA_MEALS_WS_INTERNAL_URL=http://localhost:8000
# Même secret que `INTERNAL_NOTIFY_SECRET` sur africa-meals-ws (header X-Internal-Secret).
INTERNAL_NOTIFY_SECRET=
# Alias optionnel (WsInboxNotifyService)
# INTERNAL_WS_NOTIFY_SECRET=

# Liens vendeur / dashboard (emails, invitations — store.service, Stripe Connect)
# DASHBOARD_BASE_URL=https://wise-eat.com
# VENDOR_SIGNUP_URL=
# FRONTEND_URL=
# CLIENT_APP_URL=

# --- Cache perf (Nest cache-manager global) ---
# Liste publique `GET /api/product-categories` + query GraphQL `productCategories` (ms)
# PRODUCT_CATEGORIES_CACHE_TTL_MS=120000
# Bundle accueil GraphQL `shopHome` (ms)
# SHOP_HOME_CACHE_TTL_MS=90000
# TTL cache public catalogue / recherche / menu boutique / détail plat (ms)
# API_PUBLIC_CACHE_TTL_MS=90000
# Favoris GraphQL (ms)
# FAVORITES_CACHE_TTL_MS=25000
# Logs HTTP : corps des requêtes (déconseillé en prod — coût CPU / fuite données)
# LOG_HTTP_BODIES=false
# Forcer en production uniquement si absolument nécessaire (L-05)
# LOG_HTTP_BODIES_IN_PROD=false

# --- Ads targeting ---
# Conservation des événements comportementaux (jours)
# ADS_TARGETING_DATA_RETENTION_DAYS=90

# --- Redis ---
# URI complète (préférée)
# REDIS_URL=redis://default:<password>@host:port
# Variables détaillées (si votre client Redis les lit séparément)
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=
# REDIS_TLS=false
#
# --- BullMQ (API -> WS internal notify queue) ---
# WS_NOTIFY_QUEUE_NAME=ws-notify
# WS_NOTIFY_QUEUE_CONCURRENCY=20
# WS_NOTIFY_QUEUE_ATTEMPTS=4
# WS_NOTIFY_QUEUE_BACKOFF_MS=750
# WS_NOTIFY_QUEUE_KEEP_COMPLETED=1000
# WS_NOTIFY_QUEUE_KEEP_FAILED=5000
# WS_NOTIFY_REQUEST_TIMEOUT_MS=8000
#
# --- Domain events (EDA bus — distinct de internal/ws) ---
# DOMAIN_EVENTS_ENABLED=false
# DOMAIN_EVENTS_QUEUE_NAME=domain-events
# DOMAIN_EVENTS_QUEUE_CONCURRENCY=10
# DOMAIN_EVENTS_QUEUE_ATTEMPTS=4
# DOMAIN_EVENTS_QUEUE_BACKOFF_MS=750
# DOMAIN_EVENTS_QUEUE_KEEP_COMPLETED=2000
# DOMAIN_EVENTS_QUEUE_KEEP_FAILED=5000
# DOMAIN_EVENTS_IDEMPOTENCY_TTL_SEC=86400
# DOMAIN_EVENTS_HANDLERS_ASYNC=true
# DOMAIN_EVENTS_HANDLERS_QUEUE_NAME=domain-events-handlers
# DOMAIN_EVENTS_HANDLERS_QUEUE_CONCURRENCY=5
# DOMAIN_EVENTS_HANDLERS_QUEUE_ATTEMPTS=4
# DOMAIN_EVENTS_HANDLERS_QUEUE_BACKOFF_MS=750
# DOMAIN_EVENTS_HANDLERS_QUEUE_KEEP_COMPLETED=2000
# DOMAIN_EVENTS_HANDLERS_QUEUE_KEEP_FAILED=5000
# DOMAIN_EVENTS_WS_VIA_BUS=true
# DOMAIN_EVENTS_MQTT_TOPIC_PREFIX=africameals/domain
#
# --- GPS livreur (OPT-002) ---
# COURIER_GPS_THROTTLE_MS=3000
# COURIER_GPS_COORD_PRECISION=4
#
# --- SSE (Server-Sent Events) ---
# POLL-000 : l’API publie sur Redis ; le flux HTTP SSE est servi par africa-meals-ws (Cloud Run).
SSE_HOST_ON_WS=true
SSE_REDIS_BRIDGE_ENABLED=true
SSE_HTTP_ON_API=false
# SSE_HEARTBEAT_MS=20000
# SSE_MAX_CONNECTIONS_PER_USER=5
# REQUEST_STATS_SSE_PUSH_MS=10000
# STATUS_PROBE_WEB_URL=https://wise-eat.com/
# STATUS_PROBE_ADMIN_URL=https://admin.wise-eat.com/
# WS_BASE_URL=https://ws.wise-eat.com
# STATUS_PROBE_TIMEOUT_MS=8000
#
# --- MQTT Broker (HiveMQ Cloud / autre broker) ---
# MQTT_BROKER_HOST=
# MQTT_BROKER_PORT=8883
# MQTT_BROKER_WS_PORT=8884
# MQTT_BROKER_USERNAME=
# MQTT_BROKER_PASSWORD=
# MQTT_BROKER_URL=mqtts://host:8883
# MQTT_BROKER_WS_URL=wss://host:8884/mqtt
# MQTT_BROKER_PROTOCOL=mqtts
# MQTT_TOPIC_PREFIX=africameals/internal/ws
# MQTT_QOS=1
# MQTT_CONNECT_TIMEOUT_MS=8000
# MQTT_KEEPALIVE_SEC=30
# MQTT_RECONNECT_MS=2000
#
# --- Crons : pause/reprise admin → Integrity Check → Cron Jobs (collection infra_cron_job_states) ---
# Désactivation déploiement : DISABLE_<JOB>_CRON=true (voir cron-jobs.registry.ts)
# DISABLE_ADS_TARGETING_RETENTION_CRON=true
#
# --- Rapport d'activité vendeur (e-mail + Excel, un envoi par propriétaire) ---
# Destinataires : e-mail du compte propriétaire de chaque boutique ACTIVE/INACTIVE.
# Fréquence (quotidien / hebdo / mensuel) : admin Paramètres → Rapport vendeur
# ADMIN_OPS_REPORT_CRON=15 * * * *
# DISABLE_ADMIN_OPS_REPORT_CRON=true
#
# --- Promotions planifiées (plats vendeur : prix / promo par plage de dates) ---
# PRODUCT_DISCOUNT_SCHEDULE_CRON=0/5 * * * *
# DISABLE_PRODUCT_DISCOUNT_SCHEDULE_CRON=true
