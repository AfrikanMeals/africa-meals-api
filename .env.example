APP_NAME="Wise Eat"
NODE_ENV=local
NODE_PORT=9000
# Build + start local (prod PM2) : 9001 — voir docs/PORTS.md
# NODE_PORT=9001
# Durée max d’une requête HTTP (ms) — réception + traitement. Défaut 60000 (1 min).
# HTTP_REQUEST_TIMEOUT_MS=60000
# URL publique de l’API (PayPal return/cancel, liens absolus). Aligner sur le déploiement réel.
SERVER_URL=http://localhost:9000
# Build + start local : http://localhost:9001

# Swagger `/api/docs` — désactivé en prod par défaut (M-02). Dev : opt-out via DISABLE_SWAGGER=true
# DISABLE_SWAGGER=false
# ENABLE_SWAGGER_IN_PROD=false

# GraphQL Playground + introspection — désactivés en prod par défaut (M-02)
# DISABLE_GRAPHQL_PLAYGROUND=false
# ENABLE_GRAPHQL_PLAYGROUND_IN_PROD=false

# Limites corps HTTP (M-03) — JSON 5 MB par défaut ; 25 MB sur routes upload JSON
# HTTP_JSON_BODY_LIMIT=5mb
# HTTP_UPLOAD_JSON_BODY_LIMIT=25mb
# HTTP_URLENCODED_BODY_LIMIT=1mb

# Diagnostic env (GET /api/debug/env) — jamais actif si NODE_ENV=production
# ENABLE_ENV_DEBUG=true
# ENV_DEBUG_BASIC_USER=
# ENV_DEBUG_BASIC_PASS=

# Test e-mail (POST /api/mailer/test-email) — jamais actif si NODE_ENV=production
# ENABLE_MAILER_TEST_EMAIL=true

# Origines CORS autorisées (H-01) — séparées par des virgules, sans slash final.
# Production (obligatoire) :
# CORS_ORIGIN=https://admin.wise-eat.com,https://wise-eat.com,https://www.wise-eat.com
# Local (admin :3001, web firebase :5000, ancien dashboard :3000) :
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5000

## DNS (mongodb+srv — lookup SRV Atlas)
# Par défaut : résolveurs système (recommandé). Ne pas forcer 1.1.1.1 si SRV Atlas échoue.
# DNS_SERVERS=1.1.1.1,8.8.8.8
# DNS_RESULT_ORDER=ipv4first

## Maintenance base de données (dashboard admin — vider des collections)
# En production : laisser absent ou `false` sauf intervention explicite (`true`).
# ALLOW_DB_MAINTENANCE=true

## Stats requêtes (dashboard admin /admin/stats — tampon mémoire)
REQUEST_STATS_ENABLED=false
REQUEST_STATS_MAX_ENTRIES=10000

## Database
# Alternative à DB_HOST / DB_USERNAME / … : URI MongoDB complète
# MONGODB_URI=mongodb+srv://user:pass@cluster.example.net/dbname
# MONGO_URI=…
DB_HOST=main.8zkud1m.mongodb.net
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Pool Mongoose — garder bas sur Atlas (connexions / nœud = somme API + WS + autres × instances).
# MONGOOSE_MAX_POOL=20
# MONGOOSE_MIN_POOL=0
# Fermeture des connexions inactives du pool (ms) — défaut 45s
# MONGOOSE_MAX_IDLE_MS=45000
# MONGOOSE_SERVER_SELECTION_MS=8000
# MONGOOSE_WAIT_QUEUE_MS=30000
# Timeout socket lecture/écriture (ms)
# MONGOOSE_SOCKET_TIMEOUT_MS=45000
# Fréquence heartbeat monitoring (ms) — un peu plus espacé = moins de trafic
# MONGOOSE_HEARTBEAT_FREQ_MS=30000
# Connexions TCP ouvertes en parallèle lors d’un pic de demande (pilote Node)
# MONGOOSE_MAX_CONNECTING=3
# Nom client dans les métriques Atlas (URI construite depuis DB_*)
# MONGODB_APP_NAME=africa-meals-api

## Stripe (panier groupé : Checkout Session et/ou PaymentIntent + Payment Sheet mobile)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Plusieurs secrets possibles (ex: Stripe CLI + Dashboard/Event Destination), séparés par virgule.
# STRIPE_WEBHOOK_SECRETS=whsec_cli...,whsec_dashboard...
# Seuil d'alerte (minutes) pour le check "Webhook Stripe last activity" dans Integrity/System Health.
# STRIPE_WEBHOOK_ACTIVITY_MAX_AGE_MIN=30
# Cible p95 (ms) pour l'ack HTTP webhook Stripe (check system-health `stripe-webhook-latency`, EDA-006).
# STRIPE_WEBHOOK_P95_TARGET_MS=500
# Taille fenêtre glissante des échantillons latence webhook (par worker API).
# STRIPE_WEBHOOK_METRICS_MAX_SAMPLES=200
# Limite de scan des integrity tests gourmands (commandes/docs Stripe les plus récents).
# INTEGRITY_TEST_SCAN_LIMIT=5000
# Âge max (heures) toléré pour une commande restant en statut `created`.
# INTEGRITY_CREATED_ORDER_MAX_AGE_HOURS=2
# Config paiements Checkout (Dashboard → Paramètres → Méthodes de paiement) : pmc_…
# STRIPE_PAYMENT_METHOD_CONFIGURATION=pmc_xxxxxxxx
# Webhook Dashboard : même endpoint POST /api/billing/stripe/webhook — activer au minimum
# « checkout.session.completed » (Checkout navigateur) et « payment_intent.succeeded » (Apple Pay / Google Pay / cartes in-app).
# URLs de retour après paiement (optionnel : défaut = page web SSE ou API)
# Avec PUBLIC_WEB_URL : défaut commandes → https://wise-eat.com/checkout-success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5002/checkout-success?session_id={CHECKOUT_SESSION_ID}
# Retour dans l’app mobile (schéma enregistré Android/iOS) :
# STRIPE_CHECKOUT_SUCCESS_URL=wise-eat://stripe-return?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:9000/api/billing/stripe/payment-cancel
# Abonnement vendeur — mobile : PaymentIntent + Payment Sheet (`POST /subscriptions/payment-intent`).
# Checkout hébergé (secours) : page web SSE puis deep link app si PUBLIC_WEB_URL défini.
# STRIPE_SUBSCRIPTION_SUCCESS_URL=https://admin.wise-eat.com/settings/subscription?session_id={CHECKOUT_SESSION_ID}
# STRIPE_SUBSCRIPTION_CANCEL_URL=http://localhost:9000/api/billing/stripe/payment-cancel
# Optionnel: URLs spécifiques au règlement du crédit Ads vendeur.
# Dashboard vendeur (admin Next.js) — utilisé pour les retours Stripe crédit Ads.
# ADMIN_APP_URL=http://localhost:3001
# Sans STRIPE_AD_CREDIT_* : succès → {ADMIN_APP_URL}/ad-credit-return?ad_credit_session_id={CHECKOUT_SESSION_ID}
# STRIPE_AD_CREDIT_SUCCESS_URL=http://localhost:3001/ad-credit-return?ad_credit_session_id={CHECKOUT_SESSION_ID}
# STRIPE_AD_CREDIT_CANCEL_URL=http://localhost:3001/ad-credit-return?ad_credit_payment=cancel
## Stripe Connect (versements vendeurs — admin)
# STRIPE_CONNECT_ADMIN_BASE_URL=http://localhost:3000
# STRIPE_CONNECT_RETURN_URL=http://localhost:3000/finances/versements?connect=return
# STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/finances/versements?connect=refresh
# Site web prérempli sur l’onboarding Stripe vendeur : {PUBLIC_WEB_URL}/stores/{id-nom}
# Livreurs : fallback DASHBOARD_BASE_URL / STRIPE_CONNECT_BUSINESS_WEBSITE_URL
# PUBLIC_WEB_URL=https://wise-eat.com
# DASHBOARD_BASE_URL=https://wise-eat.com
# STRIPE_CONNECT_BUSINESS_WEBSITE_URL=https://wise-eat.com
# Transferts Connect après paiement (plateforme → compte vendeur). false pour désactiver.
# STRIPE_CONNECT_TRANSFERS_ENABLED=true
# STRIPE_CONNECT_TRANSFER_CURRENCY=cad
# Pénalités / compensations Connect (admin). false pour désactiver.
# STRIPE_PENALTIES_ENABLED=true
# Frais Stripe processing (repli si balance_transaction indisponible) : ~2,9 % + 0,30 $ ;
# estimation prudente max(2,9 %, 3,7 %) + 0,30 $ — voir stripe-processing-fee.util.ts

## JWT (H-03)
JWT_SECRET=2vYTSfXEuzF1S4Fy
# Access token court (15–60 min recommandé)
JWT_EXPIRATION=30m
# Secret distinct obligatoire en production (M-08 — pas de fallback sur JWT_SECRET)
JWT_REFRESH_SECRET=change-me-refresh-secret-distinct-from-jwt-secret
JWT_REFRESH_EXPIRATION=30d

# Rate limiting routes auth (H-02)
AUTH_RATE_LIMIT_ENABLED=true

## Mail (SMTP / nodemailer) — inscription, vérification, mot de passe oublié
# true = pas d’email, compte marqué vérifié tout de suite (pratique en local)
SKIP_EMAIL_VERIFICATION=false
SUPPORT_EMAIL=support@yourdomain.com
# Mise en page e-mails (logo, couleurs, lien site) — voir docs/MAIL_SETUP.md
# Logo + couleurs reçus PDF / e-mails (facture client après paiement)
# EMAIL_LOGO_URL=https://votre-domaine.com/logo.png
# EMAIL_WEBSITE_URL=https://wise-eat.com
# EMAIL_WEBSITE_URL=https://votre-domaine.com
# Lien « Voir la commande » des e-mails + balisage Gmail (Schema.org Order + Invoice).
# Doit être une URL https publique. `{orderId}` est remplacé par l'id de commande ;
# sans placeholder, l'id est ajouté en suffixe : <base>/orders/<id>.
# PUBLIC_WEB_URL sert aussi aux URLs produit dans acceptedOffer (JSON-LD).
# Lien « Voir la commande » (JSON-LD ViewAction + bouton e-mail). Fallback : PUBLIC_WEB_URL/orders/{orderId}
# EMAIL_ORDER_URL_TEMPLATE=https://wise-eat.com/orders/{orderId}
# E-mails notifications publicitaires (expéditeur marketing, distinct de SMTP_USER)
# Notifications Ads — reprend SMTP_HOST / SMTP_PORT ; seuls user / mot de passe / from diffèrent
# AD_SMTP_USER=sales@votre-domaine.com
# AD_SMTP_APP_PASSWORD=
# AD_SMTP_FROM=sales@votre-domaine.com
# AD_SMTP_FROM_NAME=Wise Eat
# AD_SMTP_HOST=   # optionnel ; défaut = SMTP_HOST
# AD_SMTP_PORT=   # optionnel ; défaut = SMTP_PORT
# PUBLIC_WEB_URL=https://votre-domaine.com
# HTTP Basic Auth — flux Google Merchant Center (export toutes boutiques)
# GOOGLE_MERCHANT_BASIC_AUTH_USER=
# GOOGLE_MERCHANT_BASIC_AUTH_PASSWORD=
# Sitemap site vitrine — déclenche GitHub Actions `regenerate-sitemap` (africa-meals-web)
# PAT fine-grained : repo africa-meals-web, Contents read + Actions write (ou classic repo scope)
# GITHUB_SITEMAP_DISPATCH_TOKEN=ghp_…
# GITHUB_SITEMAP_DISPATCH_REPO=VOTRE_ORG/africa-meals-web
# GITHUB_SITEMAP_DISPATCH_DEBOUNCE_MS=120000
# URL publique de l’API (clics e-mail/SMS notifications ads → /ads/notifications/click/:id)
# API_PUBLIC_BASE_URL=https://api.wise-eat.com
# Worker envoi notifications ads (cron Nest, défaut */3 * * * *)
# AD_NOTIFICATION_DISPATCH_CRON=*/3 * * * *
# DISABLE_AD_NOTIFICATION_DISPATCH_CRON=true
# Secret HMAC pour jetons de tracking clic pub (M-18) — distinct de JWT_SECRET recommandé
# AD_NOTIFICATION_TRACK_SECRET=
# Bird Channels API — SMS et WhatsApp (https://docs.bird.com/api/channels-api)
# Guide déploiement : docs/BIRD_CHANNELS.md
#
# --- Credentials Bird (Secret Manager en prod) ---
# BIRD_ACCESS_KEY=
# BIRD_WORKSPACE_ID=
# BIRD_SMS_CHANNEL_ID=          # UUID canal SMS (dashboard Bird → Channels)
# BIRD_WHATSAPP_CHANNEL_ID=     # UUID canal WhatsApp
# BIRD_API_BASE_URL=https://api.bird.com
#
# --- SMS ads ---
# AD_NOTIFICATION_SMS_ENABLED=true
# AD_NOTIFICATION_SMS_DEFAULT_COUNTRY_CODE=1
#
# --- WhatsApp ads ---
# AD_NOTIFICATION_WHATSAPP_ENABLED=true
# AD_NOTIFICATION_WHATSAPP_DEFAULT_COUNTRY_CODE=1
# template = promos hors fenêtre 24 h (défaut) | text = messages libres (fenêtre 24 h)
# AD_NOTIFICATION_WHATSAPP_SEND_MODE=template
# ID projet template Bird Studio (mode template) — remplace l’ancien TEMPLATE_NAME Meta
# AD_NOTIFICATION_WHATSAPP_TEMPLATE_PROJECT_ID=
# AD_NOTIFICATION_WHATSAPP_TEMPLATE_VERSION=latest
# AD_NOTIFICATION_WHATSAPP_TEMPLATE_LANGUAGE=fr
# Clés des paramètres template (ordre : boutique, titre, message) — doivent matcher Bird Studio
# AD_NOTIFICATION_WHATSAPP_TEMPLATE_PARAM_KEYS=store_name,title,message
# Paramètre URL dynamique (suffixe après préfixe fixe du template)
# AD_NOTIFICATION_WHATSAPP_TEMPLATE_URL_BUTTON=true
# AD_NOTIFICATION_WHATSAPP_TEMPLATE_URL_PREFIX=https://api.wise-eat.com/ads/notifications/click/
# AD_NOTIFICATION_WHATSAPP_TEMPLATE_URL_PARAM_KEY=url_suffix
# Ajouter l’URL de clic comme paramètre corps (alternative au bouton URL)
# AD_NOTIFICATION_WHATSAPP_TEMPLATE_BODY_URL_PARAM=false
# MOBILE_DEEP_LINK_SCHEME=wise-eat
# Lien(s) téléchargement app mobile (e-mails onboarding livreur).
# Priorité : Paramètres admin → Apps & Contact (App Store / Play Store en base).
# Repli si non configurés en admin :
# MOBILE_APP_DOWNLOAD_URL=https://wise-eat.com/app
# MOBILE_APP_IOS_URL=https://apps.apple.com/app/...
# MOBILE_APP_ANDROID_URL=https://play.google.com/store/apps/details?id=...
# Canal Android FCM promos (aligné app Flutter : african_meals_promotions)
# AD_NOTIFICATION_FCM_ANDROID_CHANNEL=african_meals_promotions
# File BullMQ ads-notify (nécessite REDIS_URL ou REDIS_HOST)
# AD_NOTIFICATION_QUEUE_NAME=ads-notify
# AD_NOTIFICATION_ENTITY_CONCURRENCY=2
# AD_NOTIFICATION_BATCH_CONCURRENCY=8
# AD_NOTIFICATION_RECIPIENT_BATCH_SIZE=50
# AD_NOTIFICATION_RECIPIENT_PARALLEL=12
# File BullMQ Alert System (Integrity Check → admin, nécessite REDIS_*)
# ADMIN_ALERT_EMAIL_QUEUE_NAME=admin-alert-email
# ADMIN_ALERT_EMAIL_CONCURRENCY=4
# EMAIL_BRAND_PRIMARY=#392800
# EMAIL_BRAND_ACCENT=#aa6900
# Gmail : voir docs/MAIL_SETUP.md — SMTP_APP_PASSWORD ou SMTP_PASS (mot de passe d’application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_PASS=
SMTP_FROM=
# Optionnel (expéditeur si différent de SMTP_USER)
MAILER_SENDER=
# MailerSend (alternative au SMTP) — voir mailer.service
# MAILER_API_KEY=
# Facture PDF par e-mail au client après paiement Stripe (nécessite SMTP pour la pièce jointe)
# Objet : « Your {Restaurant} order #{ref} is now complete » + JSON-LD Order (@graph) + microdata HTML.
# Prérequis Gmail : SPF/DKIM sur le domaine expéditeur, enregistrement du domaine chez Google.
# Tester le balisage : https://developers.google.com/gmail/markup/testing
# DISABLE_ORDER_PAID_INVOICE_EMAIL=true
# E-mail client « commande en livraison » (balisage Schema.org OrderInTransit, sans PDF)
# DISABLE_ORDER_SHIPPED_EMAIL=true

