APP_NAME="African Meals"
NODE_ENV=local
NODE_PORT=9000
SERVER_URL=http://localhost:9000

# Origines autorisées pour le Dashboard (séparées par des virgules). Si vide, toutes les origines en dev.
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

## Database
DB_HOST=main.8zkud1m.mongodb.net
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

## JWT
JWT_SECRET=2vYTSfXEuzF1S4Fy
JWT_EXPIRATION=1y

## Mail (SMTP / nodemailer) — inscription, vérification, mot de passe oublié
# true = pas d’email, compte marqué vérifié tout de suite (pratique en local)
SKIP_EMAIL_VERIFICATION=false
SUPPORT_EMAIL=support@yourdomain.com
# Gmail : voir docs/MAIL_SETUP.md — SMTP_APP_PASSWORD ou SMTP_PASS (mot de passe d’application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_PASS=
SMTP_FROM=
# Optionnel (expéditeur si différent de SMTP_USER)
MAILER_SENDER=

## Mapbox
MAP_BOX_API_URL=https://api.mapbox.com/search/geocode/v6/forward
MAPBOX_ACCESS_TOKEN=

## Firebase Storage (required for image/file uploads - MediasService)
## Uses Firebase Admin SDK (service account). Enable Storage: Firebase Console > Build > Storage > Get started.
## Option A: Path to service account JSON file, relative to project root (e.g. accounts.json).
# GOOGLE_APPLICATION_CREDENTIALS=accounts.json
## Option B: Or paste the full JSON content of the service account key as a single line (e.g. for Docker/CI).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# PAYPAL
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox # sandbox or live