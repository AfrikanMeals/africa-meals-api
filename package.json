{
  "name": "african-meals-api",
  "version": "0.0.1",
  "description": "African meals API",
  "author": "connect@codesphere.com",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/firebase-main.js",
  "scripts": {
    "build": "nest build",
    "build:watch": "nest build --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "NODE_OPTIONS='-r tsconfig-paths/register' nest start",
    "start:dev": "NODE_OPTIONS='-r tsconfig-paths/register' nest start --watch",
    "start:dev:resilient": "node scripts/dev-resilient.mjs start:dev",
    "start:debug": "NODE_ENV=development NODE_OPTIONS='-r tsconfig-paths/register' nest start --debug --watch",
    "start:debug:resilient": "NODE_ENV=development node scripts/dev-resilient.mjs start:debug",
    "start:prod": "node -r tsconfig-paths/register dist/main.js",
    "worker:ws-notify": "node -r tsconfig-paths/register dist/workers/ws-notify-worker.main.js",
    "docker:build": "bash scripts/docker-build.sh",
    "docker:up": "docker compose --env-file .env.docker up -d",
    "docker:down": "docker compose down",
    "pm2:start:dev": "pm2 start ecosystem.dev.config.cjs",
    "pm2:reload": "npm run build && pm2 reload ../ecosystem.config.cjs --only africa-meals-api --update-env && pm2 save",
    "serve:functions": "node scripts/firebase-functions-prepare.mjs && npm run build && npx firebase emulators:start --only functions",
    "deploy:functions": "node scripts/firebase-deploy.mjs deploy --only functions",
    "functions": "node scripts/firebase-deploy.mjs deploy --only functions",
    "deploy": "node scripts/firebase-deploy.mjs deploy",
    "functions:artifacts-policy": "npx firebase functions:artifacts:setpolicy",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --ci --forceExit --maxWorkers=2 --testPathIgnorePatterns=\"\\.(controller|service|integration)\\.spec\\.ts$\"",
    "test:domain": "jest --ci --forceExit --maxWorkers=2 --testPathPattern=\"(auth|orders|billing|cart|delivery-agent).*\\.util\\.spec\\.ts$\"",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:ci": "jest --config ./test/jest-e2e.json --ci --forceExit --runInBand --testPathPattern=\"e2e-spec\"",
    "audit:ci": "npm audit --audit-level=high",
    "bench:api": "node scripts/api-performance-report.mjs",
    "loyalty:backfill": "ts-node -r tsconfig-paths/register src/scripts/loyalty-backfill-paid-orders.ts",
    "stores:backfill-region": "ts-node -r tsconfig-paths/register src/scripts/store-region-backfill.ts",
    "orders:fix-zero-decimal": "ts-node -r tsconfig-paths/register src/scripts/fix-zero-decimal-order-amounts.ts",
    "orders:pay-on-pickup-backfill": "ts-node -r tsconfig-paths/register src/scripts/pay-on-pickup-backfill.ts",
    "medias:normalize-urls": "node dist/scripts/media-url-normalize.js",
    "medias:normalize-urls:src": "ts-node -r tsconfig-paths/register src/scripts/media-url-normalize.ts",
    "test:email-media": "ts-node -r tsconfig-paths/register src/scripts/test-email-media-images.ts"
  },
  "dependencies": {
    "@africa-meals/field-selection": "file:packages/africa-meals-field-selection",
    "@africa-meals/proto": "file:packages/africa-meals-proto",
    "@aws-sdk/client-s3": "^3.1068.0",
    "@fastify/middie": "^8.3.3",
    "@fastify/static": "^6.12.0",
    "@google-cloud/storage": "^7.21.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.7.15",
    "@nestjs/apollo": "^10.2.1",
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^9.0.0",
    "@nestjs/graphql": "^10.2.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mercurius": "^10.2.1",
    "@nestjs/mongoose": "^10.0.6",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/platform-fastify": "^9.4.3",
    "@nestjs/schedule": "^2.2.3",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "@types/memcached": "^2.2.10",
    "@types/pdfkit": "^0.17.6",
    "apollo-server-express": "^3.13.0",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.77.6",
    "cache-manager": "^5.7.6",
    "cache-manager-redis-yet": "^5.1.5",
    "class-sanitizer": "^1.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "dayjs": "^1.11.11",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "fastify": "^4.29.1",
    "firebase": "^10.12.2",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.2.2",
    "google-auth-library": "^10.6.2",
    "graphql": "^16.13.2",
    "graphql-scalars": "^1.25.0",
    "libphonenumber-js": "^1.12.40",
    "mailersend": "^2.2.0",
    "memcached": "^2.2.2",
    "mercurius": "^10.5.1",
    "mongodb": "^6.6.2",
    "mongoose": "^8.4.1",
    "mqtt": "^5.15.1",
    "neo4j-driver": "^6.2.0",
    "nodemailer": "^8.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.18.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "sharp": "^0.35.1",
    "stripe": "^22.1.1",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.13",
    "@types/jest": "29.5.1",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^2.0.11",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "firebase-tools": "^15.12.0",
    "jest": "29.5.0",
    "prettier": "^2.3.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "29.1.0",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "bson": "^6.7.0"
  },
  "resolutions": {
    "bson": "^6.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^@schemas/(.*)$": "<rootDir>/schemas/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@models/(.*)$": "<rootDir>/schema/$1",
      "^@utils/(.*)$": "<rootDir>/utils/$1",
      "^@common/(.*)$": "<rootDir>/common/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
