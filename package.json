{
  "name": "african-meals-api",
  "version": "0.0.1",
  "description": "African meals API",
  "author": "connect@codesphere.com",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/firebase-main.js",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "serve:functions": "npm run build && npx firebase emulators:start --only functions",
    "functions": "npx firebase deploy --only functions",
    "deploy": "npx firebase deploy",
    "functions:artifacts-policy": "npx firebase functions:artifacts:setpolicy",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "bench:api": "node scripts/api-performance-report.mjs",
    "loyalty:backfill": "ts-node -r tsconfig-paths/register src/scripts/loyalty-backfill-paid-orders.ts"
  },
  "dependencies": {
    "@nestjs/apollo": "^10.2.1",
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^9.0.0",
    "@nestjs/graphql": "^10.2.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.6",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/schedule": "^2.2.3",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "apollo-server-express": "^3.13.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.77.6",
    "cache-manager": "^5.7.6",
    "cache-manager-redis-yet": "^5.1.5",
    "class-sanitizer": "^1.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "dayjs": "^1.11.11",
    "express": "^4.21.0",
    "firebase": "^10.12.2",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.2.2",
    "google-auth-library": "^10.6.2",
    "graphql": "^16.13.2",
    "graphql-scalars": "^1.25.0",
    "libphonenumber-js": "^1.12.40",
    "mailersend": "^2.2.0",
    "mongodb": "^7.2.0",
    "mongoose": "^8.4.1",
    "mqtt": "^5.15.1",
    "nodemailer": "^8.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "stripe": "^22.1.1",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.13",
    "@types/jest": "29.5.1",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^2.0.11",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "firebase-tools": "^15.12.0",
    "jest": "29.5.0",
    "prettier": "^2.3.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "29.1.0",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "bson": "^6.7.0"
  },
  "resolutions": {
    "bson": "^6.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@schemas/(.*)$": "<rootDir>/schemas/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@models/(.*)$": "<rootDir>/schema/$1",
      "^@utils/(.*)$": "<rootDir>/utils/$1",
      "^@common/(.*)$": "<rootDir>/common/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
